# Copy this file to /etc/systemd/system/zsazsa.service and adapt the paths.
# Example:
#   sudo cp docs/zsazsa.service.template /etc/systemd/system/zsazsa.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zsazsa.service
#
# Production note: when running behind an Apache reverse proxy, uncomment
# ZSAZSA_BIND below so the app listens on 127.0.0.1 instead of 0.0.0.0
# and is not directly reachable on port 5000 from the network.
# See "Serving zsazsa under MISP's address" in INSTALL.md.
#
# Assume installation in /var/www/MISP/misp-custom/zsazsa

[Unit]
Description=zsazsa CTI web application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/MISP/misp-custom/zsazsa
Environment=PYTHONUNBUFFERED=1
#Environment=ZSAZSA_BIND=127.0.0.1
# SECRET_KEY can also be supplied here instead of in config/__init__.py:
# Environment=SECRET_KEY=change-me-to-a-long-random-string
ExecStart=//var/www/MISP/misp-custom/zsazsa/venv/bin/python /var/www/MISP/misp-custom/zsazsa/run_webapp.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
