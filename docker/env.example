# The settings docker-compose.yml reads. setup.sh writes them to .env from your
# answers; to do it by hand, copy this file to .env and edit it.
#
# Docker Compose reads .env on creation of containers. zsazsa never reads it.
# Changing a value does not change zsazsa. 
# Edit the config file or go the Settings page, and run docker compose restart.
# volumes/config/__init__.py

# The compose files to use, separated by ":". Add docker-compose.host.yml for a
# Redis on this host's 127.0.0.1, or docker-compose.misp-docker.yml for MISP in
# misp-docker.
COMPOSE_FILE=docker-compose.yml

# Optional services: "scheduled" for the analyser and the IMAP collector,
# "scraper" for misp-scraper. Separated by ",".
COMPOSE_PROFILES=scheduled

# Where zsazsa listens on this host.
ZSAZSA_BIND=127.0.0.1
ZSAZSA_PORT=5000

# misp-docker's network, with docker-compose.misp-docker.yml.
MISP_NETWORK=

# misp-scraper: its checkout, and the Redis it reads URLs from.
SCRAPER_DIR=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Seconds between runs.
ANALYSER_INTERVAL=3600
IMAP_COLLECTOR_INTERVAL=900
SCRAPER_CRON_INTERVAL=3600
